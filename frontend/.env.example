# Copy to .env for local overrides (gitignored). Vite only exposes vars
# prefixed VITE_ to client code — see src/api/client.ts.

# Local dev default is already http://localhost:5000, no .env needed to just
# run `flask --app api.app run` + `npm run dev`.
# VITE_API_BASE=http://localhost:5000

# Cloud deploy: point this at the deployed API (Render/Railway URL).
# VITE_API_BASE=https://pose-iq-api.onrender.com
