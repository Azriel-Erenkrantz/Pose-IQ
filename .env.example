# Copy to .env for local overrides (gitignored). Read via python-dotenv in
# core/db/__init__.py and api/app.py.

# MONGODB_URI=mongodb://localhost:27017          # local dev default
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net   # Mongo Atlas (cloud)
# MONGODB_DB=poseiq

# Comma-separated allowed origins for the deployed frontend.
# Defaults to "*" (open) when unset — set this in production.
# FRONTEND_ORIGIN=https://pose-iq.vercel.app
